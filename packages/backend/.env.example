# pissykaka addr
PISSYKAKA_HOSTNAME=scheoble.xyz
PISSYKAKA_API=https://scheoble.xyz/api

# sync tuning
# seconds between periodic full syncs (use --no-full-sync to disable full sync)
FULL_SYNC_INTERVAL_SECONDS=3600
FETCH_ENTITIES_FROM_API_BASE_LIMIT=1000
FETCH_ENTITIES_MAX_PARALLEL_JOBS=10

# db fetcher defaults
DATABASE_URL="file:./dev.db"
DEFAULT_LIMIT=20
DEFAULT_THREAD_SIZE=5

# api tuning
API_DEFAULT_LISTEN_PORT=3000
API_DEFAULT_LISTEN_HOST=0.0.0.0
# Public API base URL for local media links in responses
API_PUBLIC_BASE_URL=http://localhost:3000/api
# Local media storage directory (relative to packages/backend)
MEDIA_DATA_DIR=./media-data
# cluster mode (start:cluster): number of API workers; default = CPU core count
# CLUSTER_WORKERS=4
MODERATION_SECRET_PASS=secret

METRICS_PASSWORD="Basic base64_secret="

# sync finetunings
BANNED_BOARD_TAGS="tags,separated,by,comma"
IGNORED_BOARD_TAGS="///"

# --- P2P replication ---
# Required to enable p2p server/client (shared token auth)
# P2P_NODE_ID=node-root-1
# P2P_SYNC_TOKEN=change-me
# Replica: set upstream REST base (workers). Omit on root (pissykaka sync).
# P2P_UPSTREAM_URL=http://root-host:3000
# Primary control plane (WS + push) listen + advertise URLs for /p2p/meta
# P2P_CONTROL_LISTEN_HOST=0.0.0.0
# P2P_CONTROL_LISTEN_PORT=3002
# P2P_ADVERTISE_WS_URL=ws://root-host:3002/p2p/ws
# P2P_ADVERTISE_PUSH_URL=http://root-host:3002/p2p/push
# Base URL peers use to fetch raw rows during push (this node's API)
# P2P_CALLBACK_BASE_URL=http://this-host:3000
# P2P_CHANGELOG_MAX_AGE_DAYS=2
# P2P_CHANGELOG_MAX_ROWS=500000
